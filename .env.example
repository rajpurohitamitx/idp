NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://guardian:change_me@localhost:5432/industrial_guardian?schema=public
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
SOCKET_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=8000
IMAGE_STORAGE_PATH=./storage/images
IMAGE_MAX_BYTES=5242880
ALLOW_DEVICE_AUTO_REGISTER=false
DEMO_MODE_ENABLED=true
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SUPERVISOR_PASSWORD=Super@12345
SEED_OPERATOR_PASSWORD=Oper@12345

# --- Vercel notes ---
# Use a POOLED Postgres URL (Neon/Supabase pooler), e.g. ...?pgbouncer=true&connection_limit=1
# Set these in Vercel > Settings > Environment Variables: DATABASE_URL, JWT_SECRET (32+ chars), FRONTEND_URL
